# Copy to .env and fill in. Loaded by the backend via pydantic-settings.

# --- Required for real AI calls ---------------------------------------------

# OpenRouter: used for both text operations (refine and compile).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI: used for image generation (gpt-image-1, generate + edit endpoints).
# Needs an org verified for gpt-image-1. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Mock mode ---------------------------------------------------------------

# true = no external calls. Refine returns canned concept text, generation
# returns generated placeholder PNGs after a short delay. Lets the whole UI be
# exercised without keys. Set to false once both keys above are filled in.
MOCK_AI=true

# --- Models and settings (defaults shown) ------------------------------------

# Must be vision-capable on OpenRouter (it reads parent images and attachments).
REFINER_MODEL=anthropic/claude-sonnet-4.5
# Text only.
COMPILER_MODEL=anthropic/claude-sonnet-4.5

IMAGE_MODEL=gpt-image-1
# low | medium | high  (low is fastest and cheapest; fine for brainstorming)
IMAGE_QUALITY=low
# 1024x1024 | 1536x1024 | 1024x1536
IMAGE_SIZE=1024x1024
# Candidates per Generate
CANDIDATE_COUNT=4

# Where the SQLite file and images live (relative to the backend directory)
DATA_DIR=../data
