# Copy to .env and fill in. Loaded by the backend via pydantic-settings.
# Model IDs below were verified against OpenRouter and OpenAI docs on 2026-09-18.
# Re-verify before changing them; see "Verify versions" in AGENTS.md.

# --- Required for real AI calls ---------------------------------------------

# OpenRouter: used for both text operations (refine and compile).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI: used for image generation (gpt-image-2.5, generations + edits endpoints).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Mock mode ---------------------------------------------------------------

# true = no external calls. Refine returns canned concept text, generation
# returns generated placeholder PNGs after a short delay. Lets the whole UI be
# exercised without keys. Set to false once both keys above are filled in.
MOCK_AI=true

# --- Models and settings (defaults shown) ------------------------------------

# Must be vision-capable on OpenRouter (it reads parent images and attachments).
# anthropic/claude-sonnet-5: $2/M in, $10/M out, 1M context, image input.
REFINER_MODEL=anthropic/claude-sonnet-5
# Text only.
COMPILER_MODEL=anthropic/claude-sonnet-5

# gpt-image-2.5-sunburst = highest quality, best for precise edits.
# gpt-image-2.5-flare    = smaller and roughly half the latency; use for fast brainstorming.
IMAGE_MODEL=gpt-image-2.5-sunburst
# low | medium | high | xhigh | max | auto  (low is fastest and cheapest)
IMAGE_QUALITY=low
# 1024x1024 | 1536x1024 | 1024x1536 (custom WIDTHxHEIGHT also allowed, multiples of 16)
IMAGE_SIZE=1024x1024
# Candidates per Generate
CANDIDATE_COUNT=4

# Where the SQLite file and images live (relative to the backend directory)
DATA_DIR=../data
